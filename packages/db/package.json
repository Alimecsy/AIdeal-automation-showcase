{
  "name": "@aideal/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "prisma generate",
    "lint": "tsc -p tsconfig.json --noEmit",
    "migrate:local": "tsx scripts/run-prisma-migration.ts dev",
    "migrate:ci": "tsx scripts/run-prisma-migration.ts deploy",
    "migrate:disposable": "tsx scripts/run-prisma-migration.ts deploy",
    "patch:notifications": "tsx scripts/patch-notifications.ts",
    "upgrade:bootstrap-schema": "tsx scripts/upgrade-bootstrap-schema.ts",
    "test:db": "tsx --test tests/jobs.database.test.ts",
    "test:migration-target": "tsx --test tests/migration-target.test.ts",
    "studio": "prisma studio",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.migration.json"
  },
  "dependencies": {
    "@aideal/env": "workspace:*",
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "@aideal/tsconfig": "workspace:*",
    "@types/node": "^24.12.3",
    "prisma": "^6.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
