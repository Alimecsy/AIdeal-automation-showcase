{
  "name": "aideal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format:check": "prettier --check package.json .github/workflows/quality-gate.yml packages/db/prisma.config.ts packages/db/scripts/run-prisma-migration.ts packages/db/tests/migration-target.test.ts packages/db/tsconfig.migration.json",
    "verify": "pnpm format:check && pnpm --filter @aideal/api test && pnpm --filter @aideal/worker test && pnpm --filter @aideal/shared test && pnpm --filter @aideal/db test:migration-target && pnpm --filter @aideal/api smoke && pnpm typecheck",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @aideal/db generate",
    "db:migrate:local": "pnpm --filter @aideal/db migrate:local",
    "db:migrate:ci": "pnpm --filter @aideal/db migrate:ci",
    "db:migrate:disposable": "pnpm --filter @aideal/db migrate:disposable",
    "db:test": "pnpm --filter @aideal/db test:db",
    "db:studio": "pnpm --filter @aideal/db studio",
    "db:bootstrap:neon": "pnpm --filter @aideal/db exec tsx scripts/bootstrap-neon.ts"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
