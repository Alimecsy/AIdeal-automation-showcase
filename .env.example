# App
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/aideal?sslmode=require
# Required only by the verified migration wrapper; never use DATABASE_URL or DIRECT_URL for migrations.
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/aideal_local?sslmode=require

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Queue
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_READONLY_TOKEN=

# Email
EMAIL_PROVIDER=resend
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
FROM_EMAIL=

# AI
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.1-flash-lite
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=qwen/qwen3-max

# Research
TAVILY_API_KEY=
RESEARCH_SCRAPER_URL=http://127.0.0.1:8766
